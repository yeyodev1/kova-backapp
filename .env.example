# Plantilla — copiar a .env y rellenar. El .env real nunca se versiona.

# ─── Base ─────────────────────────────────────────────────────────────
DB_URI=mongodb://localhost:27017/kova
PORT=8100
JWT_SECRET=cambiame_por_algo_largo
SLACK_ERROR_WEBHOOK=

# Orígenes CORS extra (producción, túneles), separados por coma
CORS_ORIGINS=
FRONTEND_URL=http://localhost:5173

# ─── Admin ────────────────────────────────────────────────────────────
# Cuenta de administración que se siembra al arrancar si no existe.
# Sin ADMIN_PASSWORD no se crea nada.
ADMIN_EMAIL=admin@kovashopper.com
ADMIN_PASSWORD=
ADMIN_NAME=Administración

# ─── Correo (Resend) ──────────────────────────────────────────────────
# Sin la key el API funciona igual, pero no envía correos.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kova <onboarding@resend.dev>

# --- Vercel Cron ---
# Vercel manda Authorization: Bearer $CRON_SECRET en cada corrida.
CRON_SECRET=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Dropi Ecuador ---
# Token de Mis integraciones en dropi.ec. Header: dropi-integration-key
DROPI_API_URL=https://api.dropi.ec/integrations
DROPI_INTEGRATION_KEY=

# --- Payphone (Cajita de Pagos) ---
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=

# --- Bot de WhatsApp (BuilderBot Cloud + Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
BOT_NAME=Kova
BOT_AI_VOICE=on
BOT_SUPPORT_PHONE=
WHATSAPP_BOT_SECRET=
BOT_TEST_PHONE=
PUBLIC_WEB_URL=https://kovashopper.com
