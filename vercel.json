{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/dropi-orders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/dropi-products",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/incidents-sweep",
      "schedule": "30 * * * *"
    }
  ]
}
